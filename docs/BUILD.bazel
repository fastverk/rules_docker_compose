load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_jsonschema//util:write_source_files.bzl", "write_source_files")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")

package(default_visibility = ["//visibility:public"])

# Reference docs are stardoc-generated *and* committed to source. The
# diff_test gates assert the committed file matches what stardoc
# produces from the .bzl docstrings; CI fails if someone changes a rule
# without running `bazel run //docs:update`.
#
# Two stardoc invocations:
#   - defs.bzl owns the hand-written orchestration rules
#     (docker_compose, _up, _down, _oci_image_ref) + re-exports of the
#     schema-derived rules.
#   - compose_rules.bzl is regenerated from compose-spec; documenting
#     it captures the typed-attr surface (one entry per spec property).
stardoc(
    name = "defs_doc",
    out = "defs.md.generated",
    input = "//compose:defs.bzl",
    deps = ["//compose:defs_bzl"],
)

stardoc(
    name = "compose_rules_doc",
    out = "compose_rules.md.generated",
    input = "//compose:compose_rules.bzl",
    deps = ["//compose:compose_rules"],
)

diff_test(
    name = "defs_doc_up_to_date",
    file1 = "defs.md",
    file2 = ":defs_doc",
)

diff_test(
    name = "compose_rules_doc_up_to_date",
    file1 = "compose_rules.md",
    file2 = ":compose_rules_doc",
)

# `bazel run //docs:update` writes both stardoc outputs back to source.
write_source_files(
    name = "update",
    files = {
        "defs.md": ":defs_doc",
        "compose_rules.md": ":compose_rules_doc",
    },
)
